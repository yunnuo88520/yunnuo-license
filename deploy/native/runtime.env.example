# Optional manual alternative to configure.py. Replace both absolute paths.
# This file is sourced by start.sh; quote values as shell literals. chmod 600.
YN_ADDR='127.0.0.1:8080'
YN_DB_DRIVER='sqlite'
YN_DB='file:/ABSOLUTE/STATE/bootstrap.sqlite?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)'
YN_SQLITE_SETUP_DSN='file:/ABSOLUTE/STATE/bootstrap.sqlite?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)'
YN_DB_CONFIG_FILE='/ABSOLUTE/STATE/database.json'
YN_RELEASE_DIR='/ABSOLUTE/STATE/packages'
YN_SDK_DIR='/ABSOLUTE/RELEASE/backend/sdk'
# false: Nginx serves all pages/assets. true: compatibility mode or direct Go web.
YN_SERVE_FRONTEND='false'
YN_PUBLIC_STATIC_DIR='/ABSOLUTE/RELEASE/frontend'
YN_ADMIN_STATIC_DIR='/ABSOLUTE/RELEASE/frontend/admin-console'
YN_AGENT_STATIC_DIR='/ABSOLUTE/RELEASE/frontend/agent-console'
YN_DEVELOPER_STATIC_DIR='/ABSOLUTE/RELEASE/frontend/developer-console'
YN_CUSTOMER_STATIC_DIR='/ABSOLUTE/RELEASE/frontend/user-console'
YN_TRUST_PROXY_HEADERS='true'
YN_TRUSTED_PROXY_CIDRS='127.0.0.1/32,::1/128'
# Do not supply example encryption keys: installation generates and preserves them.
