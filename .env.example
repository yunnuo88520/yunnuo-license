# Local development defaults. Replace every value before exposing the service.
YN_ADDR=:8080
YN_DB_DRIVER=sqlite
YN_DB=file:yn-license-dev.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)
# 首次运行必须访问 /install 配置数据库和管理员，不能用环境变量跳过。
# 安装后此配置文件中的数据库优先于 YN_DB_DRIVER / YN_DB。
# 编辑 JSON 中的 admin_path（默认 /admin），重启后修改管理页面入口。
YN_DB_CONFIG_FILE=yn-license-config.json
YN_RELEASE_DIR=yn-releases
# SDK sources used to generate per-product runnable integration kits.
YN_SDK_DIR=../sdk
# Docker 默认使用持久卷内的 /var/lib/mysql/.yunnuo/database.json。
YN_SQLITE_SETUP_DSN=file:yn-license.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)
# 新安装可省略以下两个密钥，由服务随机生成并保存在私有配置文件中。
# 显式设置时，请替换示例值并长期保存，升级或重启时保持不变。
YN_CARD_PEPPER=replace-with-a-long-random-string
# Generate with: openssl rand -hex 32
YN_DATA_KEY=replace-with-64-hex-characters
# Only enable behind a trusted proxy that replaces incoming forwarding headers.
YN_TRUST_PROXY_HEADERS=false

# 客户端接口防滥用（可选，均为每 5 分钟窗口，激活失败锁定为 10 分钟窗口）。
YN_CLIENT_WRITE_RATE_LIMIT=30
YN_CLIENT_READ_RATE_LIMIT=600
# 同 IP 连续无效卡密/授权号达到阈值后临时锁定（0 不可禁用，最小值 1）。
YN_CLIENT_ACTIVATE_FAIL_LOCK=10
YN_CLIENT_VERIFY_FAIL_LOCK=30

# Required by the all-in-one Docker image.
MYSQL_DATABASE=yunnuo_license
MYSQL_USER=yunnuo
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
