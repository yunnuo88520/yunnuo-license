# Local development defaults. Replace every value before exposing the service.
YN_ADDR=:8080
YN_DB_DRIVER=sqlite
YN_DB=file:yn-license-dev.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)
YN_ADMIN_USERNAME=admin
YN_ADMIN_PASSWORD=replace-with-a-strong-password
YN_ADMIN_NAME=系统管理员
YN_CARD_PEPPER=replace-with-a-long-random-string
# Generate with: openssl rand -hex 32
YN_DATA_KEY=replace-with-64-hex-characters

# Required by the all-in-one Docker image.
MYSQL_DATABASE=yunnuo_license
MYSQL_USER=yunnuo
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
