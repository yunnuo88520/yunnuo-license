# Docker Compose configuration. Generate private random values without printing:
# python3 scripts/configure-compose.py
# This file is not a shell startup file for a native Go deployment.
YN_IMAGE=yunnuo-license:local
# Loopback for Nginx/BaoTa reverse proxy; use 0.0.0.0 only for direct/LAN access.
YN_BIND_ADDR=127.0.0.1
YN_HTTP_PORT=8080
YN_DATA_VOLUME=yunnuo-license-data
MYSQL_DATABASE=yunnuo_license
MYSQL_USER=yunnuo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
YN_METRICS_TOKEN=
# Required only by deploy/compose.production.yml (HTTPS):
YN_DOMAIN=
# Optional private generated config/backups directory; defaults to deploy/:
# YN_DEPLOY_CONFIG_DIR=/opt/yunnuo/compose-config
# Enable only behind a proxy and configure its real socket address/CIDR.
YN_TRUST_PROXY_HEADERS=false
YN_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
YN_ADMIN_ALLOWED_CIDRS=
# Data encryption keys are generated in the private persistent configuration.
# When migrating an older installation with environment keys, retain its exact values:
# YN_CARD_PEPPER=
# YN_DATA_KEY=
# Optional capacity settings (bytes):
# YN_RELEASE_TOTAL_BYTES=17179869184
# YN_RELEASE_DEVELOPER_BYTES=8589934592
# YN_RELEASE_PRODUCT_BYTES=2147483648
# YN_RELEASE_PRODUCT_VERSIONS=100
# YN_RELEASE_CONCURRENT_UPLOADS=2
# YN_RELEASE_CONCURRENT_DOWNLOADS=8
